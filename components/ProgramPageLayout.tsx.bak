                                    {pathwaySteps.map((step, i) => (
                                        <FadeInSection key={i} delay={i * 120}>
                                            <div className={`text-center rounded-2xl p-6 border-2 transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1 ${step.active
                                                ? 'bg-ucb-blue text-white border-ucb-blue'
                                                : i === 0
                                                    ? 'bg-white border-ucb-orange text-gray-800'
                                                    : 'bg-white border-gray-200 text-gray-500'
                                                }`}>
                                                <div className={`text-xs font-bold uppercase tracking-widest mb-2 ${step.active ? 'text-blue-200' : i === 0 ? 'text-ucb-orange' : 'text-gray-300'}`}>
                                                    Step {i + 1}
