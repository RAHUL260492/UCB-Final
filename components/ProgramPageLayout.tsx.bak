import {
    BookOpen, Clock, Globe, Briefcase, CheckCircle, TrendingUp,
    Users, DollarSign, Calendar, Award, GraduationCap, ArrowRight,
    ChevronDown, Star, Quote, Zap, Target, Shield
} from 'lucide-react';
