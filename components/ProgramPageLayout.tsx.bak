                                                <div className="font-black text-lg leading-tight mb-1">{step.label}</div>
                                                {step.credits && (
                                                    <div className={`text-xs font-medium ${step.active ? 'text-blue-200' : 'text-gray-400'}`}>{step.credits}</div>
