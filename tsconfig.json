{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true
  },
  "include": ["src/**/*", "pages/**/*", "components/**/*", "App.tsx", "index.tsx", "types.ts"],
  "exclude": ["node_modules", "dist", "sanity-studio", "update_pages.js", "update_heroes.js", "enhance_program.js", "migratePrograms.mjs", "scrape.mjs", "seedHomepage.mjs", "space_script.cjs"]
}